generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN_IMOBILIARIA
  CORRETOR
  CLIENTE
}

enum PropertyType {
  NOVO
  USADO
  PLANTA
}

enum PropertyPurpose {
  VENDA
}

enum PropertyStatus {
  DISPONIVEL
  RESERVADO
  VENDIDO
  INATIVO
}

enum PropertyCity {
  VALPARAISO
  LUZIANIA
  CIDADE_OCIDENTAL
  JARDIM_INGA
}

enum PropertyRequestStatus {
  PENDENTE
  APROVADO
  RECUSADO
}

enum PropertyUnitStatus {
  DISPONIVEL
  VENDIDO
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  passwordHash   String
  role           UserRole
  realEstateId   String?
  realEstate     RealEstate?    @relation(fields: [realEstateId], references: [id])
  brokerProfile  BrokerProfile?
  createdInvites BrokerInvite[]
  properties     Property[]     @relation("BrokerProperties")
  soldProperties Property[]     @relation("SoldProperties")
  soldUnits      PropertyUnit[] @relation("SoldPropertyUnits")
  agios          Agio[]         @relation("BrokerAgios")
  favorites      FavoriteProperty[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model RealEstate {
  id          String            @id @default(uuid())
  name        String
  cnpj        String            @unique
  phone       String
  email       String            @unique
  mainCity    PropertyCity
  users       User[]
  brokers     BrokerProfile[]
  properties  Property[]
  agios       Agio[]
  requests    PropertyRequest[]
  invites     BrokerInvite[]
  salesControls SalesControl[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model BrokerInvite {
  id           String     @id @default(uuid())
  token        String     @unique
  realEstateId String
  realEstate   RealEstate @relation(fields: [realEstateId], references: [id])
  createdById  String
  createdBy    User       @relation(fields: [createdById], references: [id])
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
}

model BrokerProfile {
  id           String            @id @default(uuid())
  creci        String?
  phone        String?
  avatarUrl    String?
  linkedAt     DateTime          @default(now())
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  realEstateId String
  realEstate   RealEstate        @relation(fields: [realEstateId], references: [id])
  requests     PropertyRequest[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Property {
  id                String           @id @default(uuid())
  title             String
  description       String
  type              PropertyType
  purpose           PropertyPurpose
  status            PropertyStatus   @default(DISPONIVEL)
  price             Decimal          @db.Decimal(12, 2)
  commissionPrice   Decimal          @default(0) @db.Decimal(12, 2)
  city              PropertyCity
  neighborhood      String
  address           String
  mapUrl            String?
  areaM2            Decimal          @db.Decimal(10, 2)
  bedrooms          Int
  bathrooms         Int
  parkingSpaces     Int
  availableUnits    String[]         @default([])
  acceptsFinancing  Boolean          @default(false)
  featured          Boolean          @default(false)
  realEstateId      String
  realEstate        RealEstate       @relation(fields: [realEstateId], references: [id])
  brokerId          String?
  broker            User?            @relation("BrokerProperties", fields: [brokerId], references: [id])
  soldById          String?
  soldBy            User?            @relation("SoldProperties", fields: [soldById], references: [id])
  soldAt            DateTime?
  sourceRequestId   String?          @unique
  sourceRequest     PropertyRequest? @relation(fields: [sourceRequestId], references: [id])
  images            PropertyImage[]
  units             PropertyUnit[]
  favoritedBy       FavoriteProperty[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model FavoriteProperty {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model PropertyUnit {
  id                 String             @id @default(uuid())
  label              String
  status             PropertyUnitStatus @default(DISPONIVEL)
  propertyId         String
  property           Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  soldById           String?
  soldBy             User?              @relation("SoldPropertyUnits", fields: [soldById], references: [id])
  soldByExternalName String?
  soldAt             DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([propertyId, label])
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model PropertyRequest {
  id               String                 @id @default(uuid())
  title            String
  description      String
  type             PropertyType
  purpose          PropertyPurpose
  status           PropertyRequestStatus  @default(PENDENTE)
  rejectionReason  String?
  price            Decimal                @db.Decimal(12, 2)
  commissionPrice  Decimal                @default(0) @db.Decimal(12, 2)
  city             PropertyCity
  neighborhood     String
  address          String
  mapUrl           String?
  areaM2           Decimal                @db.Decimal(10, 2)
  bedrooms         Int
  bathrooms        Int
  parkingSpaces    Int
  availableUnits   String[]               @default([])
  acceptsFinancing Boolean                @default(false)
  featured         Boolean                @default(false)
  brokerProfileId  String
  brokerProfile    BrokerProfile          @relation(fields: [brokerProfileId], references: [id])
  realEstateId     String
  realEstate       RealEstate             @relation(fields: [realEstateId], references: [id])
  property         Property?
  images           PropertyRequestImage[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model PropertyRequestImage {
  id                String          @id @default(uuid())
  url               String
  propertyRequestId String
  propertyRequest   PropertyRequest @relation(fields: [propertyRequestId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
}

model Agio {
  id                       String         @id @default(uuid())
  title                    String
  description              String
  status                   PropertyStatus @default(DISPONIVEL)
  price                    Decimal        @db.Decimal(12, 2)
  commissionPrice          Decimal        @default(0) @db.Decimal(12, 2)
  installmentAmount        Decimal        @db.Decimal(12, 2)
  outstandingBalance       Decimal        @db.Decimal(12, 2)
  roomInfo                 String
  areaM2                   Decimal        @db.Decimal(10, 2)
  plannedFurniture         Boolean        @default(false)
  hasDebtsOrProcurations   Boolean        @default(false)
  debtNotes                String?
  firstOwner               Boolean        @default(false)
  paidInstallments         Int
  city                     PropertyCity
  neighborhood             String
  address                  String
  mapUrl                   String?
  condominiumName          String
  realEstateId             String
  realEstate               RealEstate     @relation(fields: [realEstateId], references: [id])
  brokerId                 String?
  broker                   User?          @relation("BrokerAgios", fields: [brokerId], references: [id])
  images                   AgioImage[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

model AgioImage {
  id        String   @id @default(uuid())
  url       String
  agioId    String
  agio      Agio     @relation(fields: [agioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SalesControl {
  id                 String     @id @default(uuid())
  clientCpf          String
  propertyName       String
  clientName         String
  builder            String?
  saleDate           DateTime
  cca                String?
  signatureDate      DateTime?
  dispatcherPaid     Boolean    @default(false)
  paymentMethod      String?
  notes              String?
  realEstateId       String
  realEstate         RealEstate @relation(fields: [realEstateId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}
